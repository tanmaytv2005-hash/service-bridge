NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/servicebridge?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Required in production (32+ random characters); keep it private and unchanged.
AADHAAR_FINGERPRINT_SECRET=

# Keep false in production. Set true only for a hosted classroom demo without SMS delivery.
DEMO_OTP_ECHO=false

# Razorpay TEST mode keys (Dashboard > Test mode > API keys). Never use live keys in this prototype.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional one-time admin seed credentials. Never commit real values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# Create once in the server folder: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@servicebridge.test
