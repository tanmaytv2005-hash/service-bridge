NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/servicebridge?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional but recommended for stable Aadhaar duplicate fingerprints; keep it private and unchanged.
AADHAAR_FINGERPRINT_SECRET=

# Razorpay TEST mode keys (Dashboard > Test mode > API keys). Never use live keys in this prototype.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
